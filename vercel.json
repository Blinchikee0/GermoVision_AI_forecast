{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/style.css", "destination": "/docs/style.css" },
    { "source": "/app.js", "destination": "/docs/app.js" },
    { "source": "/world.svg", "destination": "/docs/world.svg" },
    { "source": "/logo_black.png", "destination": "/docs/logo_black.png" },
    { "source": "/logo_white.png", "destination": "/docs/logo_white.png" },
    { "source": "/favicon.ico", "destination": "/docs/logo_black.png" }
  ]
}
